#!name = Tuyo KYC
#!desc = 自动提取 Tuyo Persona KYC 验证链接
#!author = GITHUB-1220
#!loon_version = 3.5.1(983)

[Script]
response if ${url} ~= /^https:\/\/api\.tuyo\.com\/account\/verification(?:\?.*)?$/i && ${request.method} == "GET" && ${response.status} == 200 then script("https://raw.githubusercontent.com/GITHUB-1220/VPN-Config/main/KYC.JS") with tag="Tuyo KYC", timeout=20, requires_body=true, debug=true

[Mitm]
hostname = api.tuyo.com
