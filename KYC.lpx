#!name = Tuyo KYC
#!desc = 获取 Tuyo Persona KYC 验证链接
#!author = GITHUB-1220
#!loon_version = 3.5.0(750)

[Script]

# Tuyo 原始 KYC 接口
http-response ^https:\/\/api\.tuyo\.com\/account\/verification(?:\?.*)?$ script-path=https://raw.githubusercontent.com/GITHUB-1220/VPN-Config/refs/heads/main/KYC.JS,requires-body=true,timeout=20,tag=Tuyo KYC Old,enable=true

# Persona Inquiry 接口
http-response ^https:\/\/withpersona\.com\/api\/internal\/verify\/v1\/inquiries\/inq_[A-Za-z0-9]+(?:\?.*)?$ script-path=https://raw.githubusercontent.com/GITHUB-1220/VPN-Config/refs/heads/main/KYC.JS,requires-body=true,timeout=20,tag=Tuyo Persona Inquiry,enable=true

[Mitm]
hostname = api.tuyo.com, withpersona.com
