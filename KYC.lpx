#!name = Tuyo KYC Inquiry Monitor
#!desc = 监测 Inquiry ID
#!author = GITHUB-1220

[Script]

http-response ^https:\/\/(?:[^\/]+\.)?withpersona\.com\/api\/internal\/verify\/v1\/inquiries\/inq_[A-Za-z0-9]+(?:\?.*)?$ script-path=https://raw.githubusercontent.com/GITHUB-1220/VPN-Config/refs/heads/main/KYC.JS,requires-body=true,timeout=20,tag=Tuyo KYC,enable=true

[Mitm]

hostname = withpersona.com, *.withpersona.com
