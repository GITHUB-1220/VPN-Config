#!name=Persona KYC Test
#!desc=Persona Inquiry ID 自动提取
#!author=ChatGPT

[Script]

request if ${url} ~= /^https?:\/\/files\.withpersona\.com\/.*inquir/i then script("https://raw.githubusercontent.com/GITHUB-1220/VPN-Config/refs/heads/main/KYC.JS") with tag="Persona KYC", timeout=20, enable=true

[MITM]

hostname = files.withpersona.com
