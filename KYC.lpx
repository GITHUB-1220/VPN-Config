#!name = Tuyo KYC
#!desc = 获取 Tuyo KYC Persona 验证链接
#!author = GITHUB-1220
#!loon_version = 3.5.1(975)

[Script]
response if ${url} ~= /^https:\/\/api\.tuyo\.com\/account\/verification(?:\?.*)?$/i && ${response.status} == 200 then script("https://raw.githubusercontent.com/GITHUB-1220/VPN-Config/main/KYC.JS") with tag="Tuyo KYC", timeout=20, requires_body=true, debug=true

[MITM]
hostname = api.tuyo.com
